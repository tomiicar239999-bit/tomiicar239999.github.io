const toggle = document.getElementById('billing-toggle');
const priceBasico = document.getElementById('price-basico');
const priceHogar = document.getElementById('price-hogar');
const priceEmpresa = document.getElementById('price-empresa');
toggle.addEventListener('change', function() {
if (this.checked) {
priceBasico.innerHTML = '$' + priceBasico.dataset.annual + '/mes (anual)';
priceHogar.innerHTML = '$' + priceHogar.dataset.annual + '/mes (anual)';
priceEmpresa.innerHTML = '$' + priceEmpresa.dataset.annual + '/mes (anual)';
} else {
priceBasico.innerHTML = '$' + priceBasico.dataset.monthly + '/mes';
priceHogar.innerHTML = '$' + priceHogar.dataset.monthly + '/mes';
priceEmpresa.innerHTML = '$' + priceEmpresa.dataset.monthly + '/mes';
}
});

