}
.faq-container {
max-width: 800px;
margin: 3rem auto 0;
}
.faq-item {
background: #ffffff;
padding: 1.5rem;
border-radius: 6px;
margin-bottom: 1rem;
box-shadow: var(--shadow);
}
.faq-item h3 {
font-size: 1.1rem;
margin-bottom: 0.75rem;
color: #111;
}
.faq-item p {
color: #666;
font-size: 0.95rem;
}
/* Contact Section */
.contact {
padding: 5rem 2rem;
max-width: 600px;
margin: 0 auto;
}
.contact h2, .contact p {
text-align: center;
}
.contact p {
color: #666;
margin-bottom: 3rem;
}
.form-group {
margin-bottom: 1.5rem;
}
.form-group label {
display: block;
margin-bottom: 0.5rem;
font-weight: 500;
}
.form-control {
width: 100%;
padding: 0.75rem;
font-size: 1rem;
border: 1px solid #ccc;
border-radius: 4px;
background-color: #fff;
}
.form-control:focus {
outline: none;
border-color: var(--primary);
box-shadow: 0 0 0 3px rgba(0,123,255,0.25);
}
textarea.form-control {
resize: vertical;
min-height: 100px;
}
/* Footer */
footer {
background-color: #111111;
color: #ffffff;
padding: 4rem 2rem 2rem;
}
.footer-grid {
display: grid;
grid-template-columns: 2fr repeat(2, 1fr);
gap: 4rem;
max-width: 1200px;
margin: 0 auto 3rem;
}
.footer-brand p {
color: #aaa;
margin-top: 1rem;
font-size: 0.95rem;
max-width: 300px;
}
.footer-column h4 {
font-size: 1.1rem;
margin-bottom: 1.5rem;
}
.footer-column ul {
list-style: none;
}
.footer-column li {
margin-bottom: 0.75rem;
}
.footer-column a {
color: #aaa;
text-decoration: none;
transition: color 0.3s;
}
.footer-column a:hover {
color: #ffffff;
}
.footer-column p {
color: #aaa;
font-size: 0.95rem;
}
.footer-bottom {
text-align: center;
padding-top: 2rem;
border-top: 1px solid #222;
color: #666;
font-size: 0.9rem;
}
/* Floating WhatsApp Button */
.whatsapp-float {
position: fixed;
bottom: 20px;
right: 20px;
background-color: #25d366;
color: white;
padding: 0.75rem 1.5rem;
border-radius: 30px;
box-shadow: 0 4px 10px rgba(0,0,0,0.15);
text-decoration: none;
font-weight: 600;
display: flex;
align-items: center;
gap: 0.5rem;
z-index: 1000;
transition: transform 0.3s;
}
.whatsapp-float:hover {
transform: scale(1.05);
}
/* Responsive Breakpoints */
@media (max-width: 992px) {
.services-grid, .pricing-grid, .steps-grid {
grid-template-columns: 1fr;
gap: 2rem;
}
.stats-grid {
grid-template-columns: repeat(2, 1fr);
gap: 1.5rem;
}
.footer-grid {
grid-template-columns: 1fr;
gap: 2.5rem;
}
}
@media (max-width: 576px) {
.hero h1 {
font-size: 2rem;
}
.cta-buttons {
flex-direction: column;
}
.stats-grid {
grid-template-columns: 1fr;
}
nav ul {
display: none;
}
}


